# Supabase PostgreSQL 연결 문자열 (Transaction Pooler, 6543 포트)
# 실제 값은 .env 에 넣고 절대 커밋하지 않는다. Vercel 에는 같은 이름으로 환경변수 등록.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
PORT=3900

# AI 레시피 생성 (platform.openai.com 에서 발급). 비워 두면 AI 생성 기능만 꺼진다.
# Vercel 에도 같은 이름으로 등록해야 배포본에서 동작한다.
OPENAI_API_KEY=<OpenAI API 키>
# 선택: 사용할 모델 (기본 gpt-5.4-mini)
# OPENAI_MODEL=gpt-5.4-mini

# 로그인 토큰(JWT) 서명 키. 아무한테도 알려주면 안 되는 긴 랜덤 문자열을 넣는다.
# 생성: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Vercel 에도 같은 이름으로 등록해야 배포본에서 로그인이 동작한다.
JWT_SECRET=<랜덤 문자열>
