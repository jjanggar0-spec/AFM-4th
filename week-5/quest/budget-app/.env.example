# Supabase PostgreSQL 연결 문자열 (Transaction Pooler, 6543 포트)
# 실제 값은 .env 에 넣고 커밋하지 않는다. Vercel 에는 같은 이름으로 환경변수 등록.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
PORT=3800

# 접속 비밀번호 (HTTP Basic Auth). 비워 두면 잠그지 않는다. Vercel 에는 반드시 등록.
APP_PASSWORD=
