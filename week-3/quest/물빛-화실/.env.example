# ── 물빛 화실 설정 ─────────────────────────────
# 이 파일을 복사해 아래 위치에 .env 로 두세요.
#   1순위: %USERPROFILE%\.mulbit\.env   ← 권장 (클라우드 동기화 폴더 밖)
#   2순위: 이 프로젝트 폴더의 .env      ← OneDrive 안이면 기동 시 경고
# 또는 MULBIT_ENV_FILE 환경변수로 경로를 직접 지정할 수 있습니다.

# 필수 -----------------------------------------
FAL_KEY=여기에-fal-키

# 선택 -----------------------------------------
PORT=3200

# 수신 주소. 기본 127.0.0.1 = 이 컴퓨터에서만 접속 가능.
# 0.0.0.0 으로 열려면 APP_PASSWORD 를 반드시 함께 설정하세요.
HOST=127.0.0.1
APP_PASSWORD=

# 생성 한도 (키가 새더라도 비용을 묶어두는 안전장치)
MAX_PAINTS_PER_WINDOW=10
MAX_CONCURRENT=2
MAX_DAILY_PAINTS=60
