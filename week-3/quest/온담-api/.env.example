# ── 온담 API 설정 ──────────────────────────────
# 이 파일을 복사해 아래 위치 중 하나에 .env 로 두세요.
#   1순위: %USERPROFILE%\.ondam\.env   ← 권장 (클라우드 동기화 폴더 밖)
#   2순위: 이 프로젝트 폴더의 .env      ← OneDrive 안이면 경고가 뜹니다
# 또는 ONDAM_ENV_FILE 환경변수로 경로를 직접 지정할 수 있습니다.

# 필수 -----------------------------------------
OPENAI_API_KEY=sk-여기에-본인-키

# 선택 -----------------------------------------
OPENAI_MODEL=gpt-4.1-mini
PORT=3000

# 수신 주소. 기본값 127.0.0.1 = 이 컴퓨터에서만 접속 가능.
# 0.0.0.0 으로 열려면 APP_PASSWORD 를 반드시 함께 설정하세요.
HOST=127.0.0.1

# 접속 암호. 비워두면 암호 없이 접속됩니다(로컬 전용일 때만 권장).
APP_PASSWORD=

# 사용 한도 (키가 새더라도 피해를 묶어두는 안전장치)
MAX_REQUESTS_PER_WINDOW=20
MAX_CONCURRENT=3
MAX_DAILY_REQUESTS=200
MAX_DAILY_TOKENS=200000
